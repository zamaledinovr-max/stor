# ---------------------------------------------------------------------------
# Copy this file to .env and replace every placeholder.
# The values below are FAKE examples. Never commit a real .env file.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development
APP_DEBUG=false
APP_DOCS_ENABLED=true

# Required. Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-value-please-32chars

# PostgreSQL (used by docker-compose). Change both the password here and in
# DATABASE_URL before exposing the database outside your machine.
POSTGRES_USER=market
POSTGRES_PASSWORD=market
POSTGRES_DB=market

# PostgreSQL connection string (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://market:market@localhost:5432/market

# Telegram bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleFakeTokenReplaceMe
TELEGRAM_BOT_USERNAME=example_market_bot
# Public HTTPS URL of the Mini App (same origin that serves frontend/)
TELEGRAM_WEBAPP_URL=https://example.com
# Comma separated Telegram IDs of administrators (get yours via /id in the bot)
TELEGRAM_ADMIN_IDS=111111111,222222222

# initData policy
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
TELEGRAM_INIT_DATA_CLOCK_SKEW_SECONDS=300

# Support link (https://t.me/... or tg://user?id=...). Leave empty to disable.
SUPPORT_URL=https://t.me/example_support
SUPPORT_LABEL=Поддержка

# Publication rules shown in the wizard. When set, the server requires
# `rules_accepted=true` in the create-listing request.
# Example: "Запрещены товары 18+, оружие, лекарства. Проверьте местное законодательство."
LISTING_RULES_TEXT=

# Browser security / CORS. Leave CORS empty when frontend and API share origin.
CORS_ALLOWED_ORIGINS=
ALLOWED_HOSTS=*
CSP_FRAME_ANCESTORS=https://web.telegram.org,https://*.telegram.org

# Advertisement block (optional). Both AD_TITLE and AD_LINK_URL are required to display it.
AD_ENABLED=false
AD_TITLE=
AD_TEXT=
AD_IMAGE_URL=
AD_LINK_URL=
AD_BUTTON_TEXT=Подробнее

# Photo storage: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/media
S3_BUCKET=
S3_PREFIX=photos
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true

# Photo limits
PHOTO_MAX_COUNT=5
PHOTO_MAX_SIZE_MB=8
PHOTO_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
PHOTO_MAX_PIXELS=40000000
PHOTO_URL_TTL_SECONDS=3600

# Rate limits (0 disables the concrete limiter)
RATE_LIMIT_REQUESTS_PER_MINUTE_PER_IP=300
RATE_LIMIT_CREATE_LISTING_PER_HOUR=20
RATE_LIMIT_UPDATE_LISTING_PER_HOUR=60
RATE_LIMIT_UPLOAD_PHOTO_PER_HOUR=60
RATE_LIMIT_STATUS_CHANGE_PER_HOUR=60
RATE_LIMIT_COMPLAINT_PER_HOUR=20

# Notifications
NOTIFICATIONS_POLL_INTERVAL_SECONDS=2
NOTIFICATIONS_BATCH_SIZE=20
NOTIFICATIONS_MAX_ATTEMPTS=5

LOG_LEVEL=INFO

# Container start switches (used by scripts/start_all.sh / Docker / Amvera)
RUN_API=1
RUN_BOT=1
RUN_MIGRATIONS=1
APP_PORT=8000
